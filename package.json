{
  "name": "chiho-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run audit && npm run typecheck && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit": "tsx scripts/audit/index.ts",
    "audit:ci": "tsx scripts/audit/index.ts && next build",
    "ci": "npm run audit && npm run typecheck && npm run lint",
    "snapshot": "tsx scripts/audit/snapshot.ts",
    "diff": "tsx scripts/audit/diff.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.3",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
